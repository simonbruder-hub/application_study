{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taktwerk",
  "version": "1.1.0",
  "identifier": "io.github.simonbruderhub.taktwerk",
  "build": {
    "frontendDist": "../../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Taktwerk",
        "url": "index.html",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "widget",
        "create": false,
        "title": "Taktwerk",
        "url": "index.html?widget",
        "width": 280,
        "height": 170,
        "minWidth": 120,
        "minHeight": 32,
        "decorations": false,
        "alwaysOnTop": true,
        "maximizable": false,
        "visible": false,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      },
      {
        "label": "handover",
        "create": false,
        "title": "Taktwerk: Daten übernehmen",
        "url": "https://simonbruder-hub.github.io/apps/taktwerk/app/?desktop=1&handover=1",
        "width": 400,
        "height": 300,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENTEyRERCNURBM0ZDRDEKUldUUi9LTmQyeTFSbmFsVG5ib1JWcnNoekExZk84dFhkSTU5QVZDS1I0UnhEV0ZCM2xwM04zbTkK",
      "endpoints": [
        "https://github.com/simonbruder-hub/apps/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Pomodoro-Timer und Stechuhr",
    "longDescription": "Taktwerk: Pomodoro-Timer und Stechuhr für Lernen und Arbeit, mit Projekten, Aufgaben, Auswertung und optionalem Sync zwischen Laptop und Handy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
