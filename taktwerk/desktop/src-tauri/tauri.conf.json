{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taktwerk",
  "version": "1.0.0",
  "identifier": "io.github.simonbruderhub.taktwerk",
  "build": {
    "frontendDist": "../../dist/single"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taktwerk",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "Pomodoro-Timer und Stechuhr",
    "longDescription": "Taktwerk: Pomodoro-Timer und Stechuhr für Lernen und Arbeit, mit Projekten, Aufgaben, Auswertung und optionalem Sync zwischen Laptop und Handy.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
