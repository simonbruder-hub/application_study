{
  "name": "pomodoro-planer",
  "version": "1.0.0",
  "private": true,
  "description": "Pomodoro-Timer mit Aufgaben, Projekt-Tracking, Auswertung und Kalender",
  "scripts": {
    "dev": "vite",
    "build:v2": "vite build",
    "build:single": "vite build --mode single && node scripts/copy-single.mjs",
    "preview": "vite preview",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/icons.mjs",
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:test": "bash supabase/test/run.sh",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "dependencies": {
    "@preact/signals": "^2.11.1",
    "@supabase/supabase-js": "2.117.2",
    "dexie": "4.4.6",
    "exceljs": "4.4.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "5.0.3"
  }
}
